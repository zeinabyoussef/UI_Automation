<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Login Functionality">
    <test name="Logintest">
        <groups>

            <define name="Regression">
                <include name="smoke"/>
                <include name="valid"/>
            </define>

            <run>
                <include name="Regression"/>
                <exclude name="invalid"></exclude>
            </run>
        </groups>
        <classes>
            <class name="Logintest"/>
        </classes>
    </test>

</suite>